# ---------------------------------------------------------------------------
# Y2KASE environment variables
# Copy this file to `.env.local` and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

# ── Database ─────────────────────────────────────────────────────────────────
# Neon PostgreSQL — create a free database at https://neon.tech
# Use the "pooled" connection string for the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Better Auth ───────────────────────────────────────────────────────────────
# Generate a 32+ byte secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""
# Auth callback base URL (no trailing slash). Defaults to NEXT_PUBLIC_SITE_URL.
BETTER_AUTH_URL="http://localhost:3000"
# Your deployed URL (no trailing slash). Localhost during dev.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── OAuth — Google ────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com
# Redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── OAuth — Apple Sign In ─────────────────────────────────────────────────────
# Requires Apple Developer account ($99/yr). Critical for iOS users.
# https://developer.apple.com/account/resources/identifiers/list/serviceId
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Used for product copy, Social Studio captions and marketing-image generation.
# https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."
#
# The AI pipeline splits into two model roles on purpose:
#
#   OPENAI_VISION_MODEL — image ANALYSIS. MagSafe verification, per-image Style
#       tags, thumbnail scoring. Returns enums and scores, never prose, so a
#       cheap open-weight model via OpenRouter is ideal.
#   OPENAI_TEXT_MODEL   — product COPY. Titles, descriptions, tags, alt text,
#       social captions: everything a shopper reads. Runs on OpenAI directly.
#
# The split is not cosmetic. Supplier photos carry burnt-in Chinese text, and a
# Chinese-trained model's strongest prior is to reply in the language it sees —
# that is what put Chinese titles on the storefront. The copy contract in
# src/lib/catalog/copy-schema.ts enforces English regardless, but keeping copy on
# a model that follows the instruction avoids paying for regenerations.
#
# Image analysis — OpenAI-compatible endpoint. Leave VISION_BASE_URL blank to use
# OpenAI directly; set it (e.g. OpenRouter) to use another provider.
VISION_BASE_URL="https://openrouter.ai/api/v1"
VISION_API_KEY="sk-or-v1-..."
# Must accept image input. Options on OpenRouter, cheapest → best:
#   qwen/qwen3-vl-8b-instruct · qwen/qwen3-vl-30b-a3b-instruct
#   qwen/qwen3.8-flash (production default — successor to 3.7 Plus)
#   qwen/qwen3.8-max (flagship; ~10× the Flash input price)
OPENAI_VISION_MODEL="qwen/qwen3.8-flash"
# Product copy + social captions. Must ALSO be vision-capable — it writes from
# the product photos. Uses OPENAI_API_KEY against OpenAI directly; override with
# COPY_BASE_URL / COPY_API_KEY to route it elsewhere.
OPENAI_TEXT_MODEL="gpt-5.4-mini"
# Image generation model for the Social Studio. Requires org verification on the
# OpenAI dashboard. Cost ≈ $0.01–0.25/image depending on size + quality.
OPENAI_IMAGE_MODEL="gpt-image-1"
# Safety cap: max AI creatives generated per rolling 24h (controls spend).
SOCIAL_DAILY_LIMIT="50"

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# Object storage for product images and videos (zero egress fees).
# 1. dash.cloudflare.com → R2 Object Storage → Create bucket → name it "y2kase-media"
# 2. Manage R2 API Tokens → Create token → Object Read & Write for that bucket
# 3. Copy the Account ID, Access Key ID, and Secret Access Key below.
# 4. Bucket settings → Public access → Enable → copy the pub-XXXX.r2.dev URL.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="y2kase-media"
# Public base URL for the bucket (no trailing slash).
# Use the r2.dev domain until you connect a custom domain. Note that r2.dev is a
# Cloudflare *development* endpoint and is rate limited: it serves the storefront
# fine, but nothing server-side should depend on it. Catalog AI steps deliberately
# read image bytes through the S3 API above and upload them to the provider, so a
# rate-limited or missing object is a named error rather than a provider mystery
# (see src/lib/catalog/image-source.ts).
R2_PUBLIC_URL=""

# Legacy `npm run ingest:images` only. The current catalog pipeline above uses
# R2; keep these blank unless you intentionally run the Cloudinary importer.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Local Catalog ─────────────────────────────────────────────────────────────
# SQLite staging database built by the ingest pipeline (scripts/build-catalog.ts).
CATALOG_DB_PATH="./data/catalog.db"
# Root folder containing product image/video subfolders. Structure it as
#   <root>/<category>/<product-slug-or-sku>/{1.jpg,2.mp4,...}
# Optional sidecars (see catalog.config.example.json):
#   <root>/catalog.config.json            → per-category defaults (type, price…)
#   <root>/<category>/<product>/listing.json → per-product overrides
# QQ / WeChat supplier dumps do NOT need to be pre-sorted: run
#   npm run catalog:classify -- --dir "D:\QQ-Downloads"
#   npm run catalog:classify:apply -- --dir "D:\QQ-Downloads"
# to file folders into this tree (Sanrio/, AirPods/, _review/, …) before ingest.
LOCAL_CATALOG_ROOT="./bestListings"
# How many products the bulk ingest processes in parallel. Higher = faster, but
# watch the vision provider's rate limits. Default 3. (1 = fully sequential.)
INGEST_CONCURRENCY="3"
# Pre-ingest folder classifier (QQ dumps → brand/type folders). Same default.
# CLASSIFY_CONCURRENCY="3"

# ── Store presentation ────────────────────────────────────────────────────────
NEXT_PUBLIC_STORE_CURRENCY="USD"
# Image rendering. Catalog photos are already WebP on R2. Production must NOT
# send them through Vercel Image Optimization unless that paid add-on is on —
# `/_next/image` currently returns 402 OPTIMIZED_IMAGE_REQUEST_PAYMENT_REQUIRED
# and the storefront shows broken images. Leave NEXT_IMAGE_OPTIMIZED unset (or
# "false"). Set it to "true" only after enabling Image Optimization in Vercel.
# NEXT_IMAGE_UNOPTIMIZED remains an extra kill switch that wins over the opt-in.
NEXT_IMAGE_OPTIMIZED="false"
NEXT_IMAGE_UNOPTIMIZED="false"
# Optional ownership tokens from Google Search Console and Bing Webmaster Tools.
# These values are public by design and render as verification meta tags.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# ── Analytics — Google Analytics 4 ────────────────────────────────────────────
# GA4 Measurement ID (https://analytics.google.com → Admin → Data Streams → Web).
# When set, gtag.js loads and the full ecommerce funnel is tracked
# (view_item, add_to_cart, begin_checkout, purchase). Leave blank to disable.
NEXT_PUBLIC_GA_ID=""

# ── Analytics — Meta (Facebook) Pixel + Conversions API ───────────────────────
# Meta Pixel enables Facebook/Instagram remarketing and Shopping ads.
# Client-side Pixel ID: https://business.facebook.com → Events Manager → Pixels
# Leave blank to disable the Pixel entirely.
NEXT_PUBLIC_META_PIXEL_ID=""
# Server-side Conversions API access token (bypasses iOS 14 / ad blockers).
# Events Manager → your Pixel → Settings → Conversions API → Generate Access Token
META_CAPI_ACCESS_TOKEN=""
# Optional: set during development to route events to Meta's test event tool.
# Events Manager → Test Events → find the code (e.g. TEST12345). Remove in prod.
META_CAPI_TEST_CODE=""

# ── Analytics — TikTok Pixel ──────────────────────────────────────────────────
# TikTok Ads Manager → Library → Events → Web Events → Set Up Web Events → Pixel
# https://ads.tiktok.com/i18n/events_manager/pixel/list
# Leave blank to disable.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""

# ── Analytics — Pinterest Tag ─────────────────────────────────────────────────
# Required to run Pinterest Shopping Ads (Performance+ campaigns).
# https://ads.pinterest.com → Ads → Conversions → Connect your Pinterest tag
# Leave blank to disable.
NEXT_PUBLIC_PINTEREST_TAG_ID=""

# ── Pinterest publishing (Social Studio P3) ───────────────────────────────────
# Enables one-click + scheduled auto-publishing of AI creatives to Pinterest.
# 1. developers.pinterest.com → create an app (Standard access).
# 2. Generate an access token with scopes: boards:read, pins:read, pins:write.
# 3. Paste the token below. Leave blank to disable auto-publishing (the studio
#    still works for generation + manual download).
PINTEREST_ACCESS_TOKEN=""
# Optional: override the API base (defaults to https://api.pinterest.com/v5).
# PINTEREST_API_BASE="https://api.pinterest.com/v5"

# ── Pinterest auto-pin drip (autonomous catalog distribution) ─────────────────
# Posts the next un-pinned LISTING to Pinterest every day — every product photo
# as an image pin plus the product video as a video pin — recording each asset
# as pinned so the whole catalog goes out one listing at a time with no
# duplicates and zero manual work. Runs via /api/cron/pinterest-autopin.
# Opt-in: must be exactly "true" to run automatically.
PINTEREST_AUTOPIN_ENABLED="false"
# How many LISTINGS a single cron run posts. Keep at 1 so the day's volume is
# spread across the scheduled cron slots (vercel.json) rather than one burst.
PINTEREST_AUTOPIN_PER_RUN="1"
# Hard cap on LISTINGS posted per UTC day across ALL runs (each listing = all
# its photos + video, ~8-14 pins). The single knob for daily volume: 1 for a
# gentle drip, 2 (≈20-28 fresh pins/day) to accelerate coverage. To go higher,
# raise this AND add matching /api/cron/pinterest-autopin slots in vercel.json.
PINTEREST_AUTOPIN_PER_DAY="1"
# Pause between individual media posts, ms (stays under Pinterest write limits).
# PINTEREST_AUTOPIN_GAP_MS="1500"
# Board to pin to. Leave blank to use the account's first board.
# Find ids via the studio's board picker, or the boards:read API.
PINTEREST_AUTOPIN_BOARD_ID=""
# How many times a single asset can fail before the drip gives up on it
# (auth failures never count — those are recovered automatically).
# PINTEREST_AUTOPIN_MAX_ATTEMPTS="3"

# ── Pinterest OAuth (required for long-lived auto-pin) ────────────────────────
# Access tokens expire ~30 days. With APP_ID + APP_SECRET, the daily cron at
# /api/cron/pinterest-refresh rotates them automatically. Connect once via
# /admin/social → "Connect Pinterest".
PINTEREST_APP_ID=""
PINTEREST_APP_SECRET=""
# Optional override (defaults to ${NEXT_PUBLIC_SITE_URL}/api/auth/pinterest/callback).
# PINTEREST_REDIRECT_URI="https://y2kase.com/api/auth/pinterest/callback"

# ── Meta content publishing — Instagram + Facebook (OPTIONAL) ────────────────
# You do NOT need these keys to post. Admin → Social → Instagram is a daily
# post pack: real catalog media + caption, you publish in the Instagram app,
# then tap "I posted this". That is the right path until the grid has ~12 posts.
#
# Graph API auto-publish is a later upgrade. It requires a Facebook Page linked
# to the IG business account, Business Verification, and Meta App Review for
# instagram_content_publish (often weeks). Do not block posting on that.
#
# If you later complete App Review:
#   1. developers.facebook.com → app → Facebook Login + Instagram
#   2. Add META_APP_ID / META_APP_SECRET, Connect on the Instagram desk
#   3. META_AUTOPOST_ENABLED=true to let /api/cron/meta-autopost fire
META_APP_ID=""
META_APP_SECRET=""
# Opt-in: must be exactly "true" to run the daily Graph API drip automatically.
META_AUTOPOST_ENABLED="false"
# How many listings a single cron run may process. The Instagram daily cap
# below is the real volume knob — leave this at 1.
META_AUTOPOST_PER_RUN="1"
# Instagram posts per UTC day. Default 1. Hard-capped at 2 in code so a typo
# cannot firehose a new account. Do not raise this until the grid has ~12 posts
# and comments are being answered.
META_IG_POSTS_PER_DAY="1"
# Optional tuning / overrides:
# META_AUTOPOST_GAP_MS="3000"
# META_AUTOPOST_MAX_ATTEMPTS="3"
# META_GRAPH_VERSION="v25.0"
# META_REDIRECT_URI="https://y2kase.com/api/auth/meta/callback"
# Pin a specific Page / IG account (otherwise the first managed Page is used).
# FACEBOOK_PAGE_ID=""
# INSTAGRAM_BUSINESS_ID=""

# ── Stripe ───────────────────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
# Use sk_test_ / pk_test_ keys for local development; sk_live_ / pk_live_ in prod.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Local dev: run `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# and copy the printed `whsec_...` value here. In prod, copy it from the
# Dashboard webhook endpoint you create for /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=""

# ── Resend (transactional email) ──────────────────────────────────────────────
# https://resend.com/api-keys  — free tier: 3,000 emails/month
# Powers the order-confirmation email sent from the Stripe webhook.
RESEND_API_KEY=""
# Verified sender address. MUST be on a domain verified in Resend — ours is the
# `send.y2kase.com` subdomain, NOT the apex y2kase.com (which has no DKIM
# records and is rejected with a 403).
#
# Avoid "Y2KASE <onboarding@resend.dev>" even for local testing: that shared
# sandbox sender only delivers to the Resend account owner's own address and
# 403s every other recipient, so signups appear to succeed while no email is
# ever sent. Point local dev at the verified domain like production does.
EMAIL_FROM="Y2KASE <orders@send.y2kase.com>"
# Keep promotional mail visually and operationally separate from receipts.
# For full reputation isolation, verify a second subdomain (for example
# news.y2kase.com) and use it here.
EMAIL_FROM_MARKETING="Y2KASE <club@send.y2kase.com>"
#
# REQUIRED before a marketing test or production send. CAN-SPAM and equivalent
# regimes require a valid physical postal address in every commercial email.
MARKETING_POSTAL_ADDRESS=""
#
# REQUIRED in production. Provision a dedicated segment and an opt-out-default
# topic explicitly, then pin their IDs here. Name-based bootstrap is available
# only outside production. Never point at the shared legacy "General" segment.
RESEND_MARKETING_SEGMENT_ID=""
RESEND_MARKETING_TOPIC_ID=""
# Development/bootstrap name overrides.
RESEND_MARKETING_SEGMENT_NAME="Y2KASE Subscribers"
RESEND_MARKETING_TOPIC_NAME="Y2KASE News & Offers"
# Keep false for an explicitly configured shared segment. Sending is blocked if
# that segment contains contacts outside the local consent ledger. The app-owned
# default segment is pruned automatically; set true only to let the app prune an
# explicitly configured segment as well.
RESEND_MARKETING_PRUNE_SEGMENT="false"
# Explicit production kill switch and hard audience ceiling. Keep disabled until
# the sender, legal footer, dedicated resources and signed webhook are verified.
MARKETING_SEND_ENABLED="false"
# May be lowered, but the synchronous implementation hard-caps at 25 until the
# provider sync/snapshot pipeline moves to a durable background worker.
MARKETING_MAX_RECIPIENTS="25"
#
# Campaign heroes use deterministic Sharp composition: exact pixels from 1–4
# live catalogue images, never an AI repaint. Assets become 1200×720 baseline
# JPEGs in R2 and always require a fresh inbox test.
MARKETING_IMAGE_DAILY_LIMIT="12"
#
# Signing secret for https://YOUR_DOMAIN/api/webhooks/resend. Subscribe the
# endpoint to contact.created, contact.updated, email.sent, email.delivered,
# email.bounced, email.complained and email.suppressed.
RESEND_WEBHOOK_SECRET=""
# Optional dedicated HMAC key for privacy-preserving consent IP hashes. When
# omitted, BETTER_AUTH_SECRET is reused so raw IP addresses are never stored.
CONSENT_HASH_SECRET=""
# Stable unsubscribe-link HMAC key. Defaults to BETTER_AUTH_SECRET for backward
# compatibility. During rotation, keep every retired value in the comma-separated
# legacy keyring so unsubscribe links in old inboxes continue to work.
UNSUBSCRIBE_SECRET=""
UNSUBSCRIBE_PREVIOUS_SECRET=""
UNSUBSCRIBE_LEGACY_SECRETS=""

# ── Admin QA tooling ──────────────────────────────────────────────────────────
# Signing key for the admin "Fresh visit" links (/admin/fresh-visit), which open
# the storefront as a browser that has never seen it. Defaults to
# BETTER_AUTH_SECRET. No rotation keyring: tickets expire after 30 minutes, so
# changing this only invalidates links generated in the last half hour.
PREVIEW_LINK_SECRET=""

# ── Cron (abandoned-cart recovery) ────────────────────────────────────────────
# Secret that authorizes Vercel Cron calls to /api/cron/abandoned-cart.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Set the SAME value in Vercel project env — Vercel sends it as a Bearer token.
CRON_SECRET=""

# ── Blog engine (AI content) ──────────────────────────────────────────────────
# Article COPY is written by Qwen via OpenRouter. Qwen 3.8 options:
#   qwen/qwen3.8-flash (balanced, default) · qwen/qwen3.8-max (flagship)
BLOG_TEXT_MODEL="qwen/qwen3.8-flash"
#
# SET ALL THREE BLOG_TEXT_* VALUES EXPLICITLY IN EVERY DEPLOYED ENVIRONMENT.
# The resolver falls back BLOG_TEXT_* -> VISION_* -> OPENAI_*, which silently
# mixes providers: with only OPENAI_API_KEY set, the default Qwen slug is sent
# to OpenAI's endpoint and 404s at generation time, not at boot. Pointing
# VISION_BASE_URL at OpenRouter is NOT the fix either — vision runs its own
# model (OPENAI_VISION_MODEL) that may legitimately be an OpenAI one, and
# rerouting it would break image classification instead. Keep the two
# independent by giving the blog its own key and base URL.
BLOG_TEXT_BASE_URL="https://openrouter.ai/api/v1"
BLOG_TEXT_API_KEY="sk-or-v1-..."
# Hero images: Nano Banana Pro (Gemini 3 Pro Image) via the KIE gateway (reuses
# KIE_API_KEY), stored in R2. "false" = use a catalog product photo as the cover.
# Requires KIE_API_KEY + R2_BUCKET_NAME; covers are skipped silently without them.
KIE_API_KEY=""
BLOG_COVER_IMAGES="true"
# Publish immediately or hold as drafts for review in /admin/blog.
# Draft/review mode is the safe default. Set exactly "true" only when the
# editorial quality process is mature enough to publish without human review.
BLOG_AUTOPUBLISH="false"
BLOG_DAILY_LIMIT="5"
BLOG_QUEUE_TARGET="12"
BLOG_CRON_BATCH="1"

# ── Live chat (tawk.to) ───────────────────────────────────────────────────────
# OPTIONAL. Leave blank and the help widget still works — it answers the common
# questions inline and escalates to email. Filling these in adds a "Chat with
# us" button that lazy-loads the tawk SDK on click (never on page load, so it
# costs nothing until someone actually wants a human).
#
# Setup:
#   1. Create a free property at https://dashboard.tawk.to
#   2. Administration → Chat Widget → copy the two ids out of the embed URL:
#      https://embed.tawk.to/<PROPERTY_ID>/<WIDGET_ID>
#   3. Paste them below and redeploy (these are NEXT_PUBLIC_, so they are
#      inlined at build time — a rebuild is required for changes to apply).
#
# Note: we render our OWN launcher and hide tawk's, so the bubble's position
# and colour in their dashboard don't matter. The conversation window does —
# it's a cross-origin iframe our CSS can't reach, so its colours have to be
# set under Widget Appearance → Advanced. The brand values are listed at the
# top of src/lib/support/live-chat.ts.
NEXT_PUBLIC_TAWK_PROPERTY_ID=""
NEXT_PUBLIC_TAWK_WIDGET_ID="default"
# Server-only. Enables tawk "secure mode": we sign the signed-in customer's
# email with this key so a visitor can't type someone else's address into the
# pre-chat form and appear in your dashboard as that customer. Without it chat
# still works, just unverified.
# Get it from: Administration → Property Settings → API Key.
# ALSO tick Administration → Property Settings → "Enable secure mode".
TAWK_API_KEY=""

# ── Admin Inbox (IMAP — hello@y2kase.com) ─────────────────────────────────────
# Enables the /admin/inbox page to read hello@y2kase.com via Namecheap Private Email.
# IMAP host for Namecheap Private Email (do not change unless you switch providers).
IMAP_HOST="mail.privateemail.com"
IMAP_PORT="993"
# Your full email address for the inbox you want to read.
IMAP_USER="hello@y2kase.com"
# The password for that email account (set in Namecheap Private Email / privateemail.com).
IMAP_PASS=""
